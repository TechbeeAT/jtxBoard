    <string name="sync_with_sync_app_heading">"與 %1$s 同步"</string>
    <string name="sync_basic_info">"jtx Board 本身不提供伺服器同步，但支援透過 DAVx⁵ 進行同步。此方法可讓您使用任意相容的 CalDAV 伺服器來儲存、備份與同步資料。"</string>
    <string name="sync_ksync_basic_info">"kSync 是一款由 Infomaniak 開發、基於 DAVx⁵ 的應用程式，專為其服務而設計。DAVx⁵ 可用於任何相容的 CalDAV 伺服器，而 kSync 僅允許 Infomaniak 帳號進行同步。"</string>
    <string name="sync_manageddavx5_basic_info">"Managed DAVx⁵ 將 DAVx⁵ 的功能帶入組織使用，並提供額外的企業功能，如大量部署、公司品牌化與可預先設定的配置。"</string>
